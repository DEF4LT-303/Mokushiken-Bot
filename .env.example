# ==========================================
# Discord VPS Monitor Bot Configuration
# ==========================================

# Discord Bot Token (Required)
# Obtain from https://discord.com/developers/applications -> Bot -> Reset Token
DISCORD_TOKEN=your_bot_token_here

# Discord Application / Client ID (Required)
# Obtain from https://discord.com/developers/applications -> General Information -> Application ID
CLIENT_ID=your_client_id_here

# Discord Guild / Server ID (Optional)
# If provided, slash commands will deploy immediately to this server for fast testing.
# If omitted or left empty, slash commands will deploy globally (can take up to an hour).
GUILD_ID=

# Monitoring Interval in seconds (Default: 30)
# Minimum allowed is 10 seconds to respect Discord API rate limits.
CHECK_INTERVAL=30

# Friendly Display Name for this VPS (Optional)
# If left empty, the machine's actual system hostname will be used.
SERVER_NAME=My-VPS-Server

# Storage File Path for persistent channel and message tracking (Default: ./data/monitor_state.json)
STORAGE_PATH=./data/monitor_state.json

# Bot Owner Discord User IDs (Optional, comma-separated)
# Used for authorization on administrative commands like /exec.
# Example: OWNER_IDS=123456789012345678,987654321098765432
OWNER_IDS=

# Enable Remote Shell Command Execution (/exec) (Default: false)
# For security reasons, keep this false unless you explicitly want to run shell commands from Discord.
ENABLE_EXEC=false
